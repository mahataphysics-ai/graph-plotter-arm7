<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://://android.com"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="6dp">

    <com.example.graphplotter.ScientificLineChart
        android:id="@+id/lineChart"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.35" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">

        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.75"
            android:background="#2C313A"
            android:padding="6dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <EditText
                    android:id="@+id/etFunctions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Functions (;)"
                    android:text="sin(x)*5"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#B0B8C4"
                    android:textSize="13sp" />
                <Button
                    android:id="@+id/btnPlot"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Plot"
                    android:textSize="12sp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <Button
                        android:id="@+id/btnCsv"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Import"
                        android:textSize="11sp" />
                    <Button
                        android:id="@+id/btnSave"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Export"
                        android:textSize="11sp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="#3E4451"
                    android:gravity="center_vertical"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:paddingLeft="4dp"
                    android:paddingRight="4dp"
                    android:layout_marginTop="4dp">
                    <Button
                        android:id="@+id/btnAddRow"
                        android:layout_width="42dp"
                        android:layout_height="36dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        android:background="#23272E"
                        android:text="+"
                        android:textColor="#4CAF50"
                        android:textStyle="bold"
                        android:textSize="18sp" />
                    <TextView
                        android:id="@+id/tvColStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="X1 vs X2"
                        android:textColor="#E0E6ED"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                    <Button
                        android:id="@+id/btnDelRow"
                        android:layout_width="42dp"
                        android:layout_height="36dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        android:background="#23272E"
                        android:text="-"
                        android:textColor="#F44336"
                        android:textStyle="bold"
                        android:textSize="18sp" />
                </LinearLayout>
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fillViewport="true">
                    <TableLayout
                        android:id="@+id/tblCsvData"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:stretchColumns="*" />
                </HorizontalScrollView>
            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginLeft="6dp"
            android:background="#E3E8F4"
            android:padding="4dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="MENU"
                    android:textColor="#1E2A38"
                    android:textStyle="bold" />
                <Button
                    android:id="@+id/btnText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="TEXT"
                    android:textSize="11sp" />
                <Button
                    android:id="@+id/btnRange"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="RANGE"
                    android:textSize="11sp" />
                <Button
                    android:id="@+id/btnGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="GRID"
                    android:textSize="11sp" />
                <Button
                    android:id="@+id/btnType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="TYPE"
                    android:textSize="11sp" />
                <Button
                    android:id="@+id/btnStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="STYLE"
                    android:textSize="11sp" />
                <Button
                    android:id="@+id/btnFit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="FIT"
                    android:textSize="11sp" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</LinearLayout>
