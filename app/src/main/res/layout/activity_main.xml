<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="6dp">

    <com.example.graphplotter.ScientificLineChart
        android:id="@+id/lineChart"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.35" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">

        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.75"
            android:background="#2C313A"
            android:padding="6dp">
            <LinearLayout
                android:layout_width="match_parent"
               android:layout_height="wrap_content"
                android:orientation="vertical">
                <EditText
                    android:id="@+id/etFunctions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Functions (;)"
                    android:text="sin(x)*5"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#B0B8C4"
                    android:textSize="13sp" />
                <Button
                    android:id="@+id/btnPlot"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Plot"
                    android:textSize="12sp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <Button
                        android:id="@+id/btnCsv"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Import"
                        android:textSize="11sp" />
                    <Button
                        android:id="@+id/btnSave"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Export"
                        android:textSize="11sp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="#3E4451"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">
                    <Button
                        android:id="@+id/btnAddRow"
                        android:layout_width="36dp"
                        android:layout_height="32dp"
                        android:text="+"
                        android:textSize="14sp" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="X"
                        android:textColor="#FFFFFF" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Y"
                        android:textColor="#FFFFFF" />
                    <Button
                        android:id="@+id/btnDelRow"
                        android:layout_width="36dp"
                        android:layout_height="32dp"
                        android:text="-"
                        android:textSize="14sp" />
                </LinearLayout>
                <TableLayout
                    android:id="@+id/tblCsvData"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stretchColumns="*" />
            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginLeft="6dp"
            android:background="#E3E8F4"
            android:padding="4dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="MENU"
                    android:textColor="#1E2A38"
                    android:textSyle="bold" />
                <Button
                    android:id="@+id/btnTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Title"
                    android:textSize="11sp" />
                <Button
                    android:id="@+id/btnXRange"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="X Range"
                    android:textSize="11sp" />
                <Button
                    android:id="@+id/btnYRange"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Y Range"
                    android:textSize="11sp" />
                <Button
                    android:id="@+id/btnLabels"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Labels"
                    android:textSize="11sp" />
                <Button
                    android:id="@+id/btnGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Grid: ON"
                    android:textSize="11sp" />
                <Button
                    android:id="@+id/btnCsvMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="CSV: Line"
                    android:textSize="11sp" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</LinearLayout>
