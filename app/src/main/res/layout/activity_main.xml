<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp">

    <com.example.graphplotter.ScientificLineChart
        android:id="@+id/lineChart"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.35" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">

        <ScrollView
            android:layout_width="0pp"
            android:layout_height="match_parent"
            android:layout_weight="1.7"
            android:paddingRight="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <EditText
                    android:id="@+id/etFunctions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Functions (; second)"
                    android:text="sin(x)*5"
                    android:textSize="13sp"
                    android:inputType="text" />

                <EditText
                    android:id="@+id/etDataPoints"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Data x,y; e.g. -5,2; 0,0"
                    android:text="-6,2; -2,-3; 1,4; 5,1"
                    android:textSize="13sp"
                    android:inputType="text" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnPlot"
                        android:layout_width="0pp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Plot"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btnCsv"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="CSV"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btnSave"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Export"
                        android:textSize="11sp" />
                </LinearLayout>

                <TableLayout
                    android:id="@+id/tblCsvData"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:stretchColumns="*" />
            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#F0F4F8"
            android:padding="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="MENU"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Title"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnXRange"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="X Range"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnYRange"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Y Range"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnLabels"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Labels"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Grid: ON"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnCsvMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="CSV: Line"
                    android:textSize="11sp" />
            </LinearLayout>
        </ScrollView>

    </LinearLayout>
</LinearLayout>
